{
  "name": "resync",
  "version": "1.0.0",
  "private": true,
  "description": "Synchronize a directory tree into a destination with restartable state",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@9.12.1",
  "engines": { "node": ">=24 <25" },
  "bin": { "resync": "./dist/cli.js" },
  "exports": { ".": "./dist/index.js" },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "9.35.0",
    "@types/node": "24.3.0",
    "eslint": "9.35.0",
    "typescript": "5.9.2",
    "typescript-eslint": "8.42.0",
    "vitest": "3.2.4"
  }
}
